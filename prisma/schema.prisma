// Bangladeshist CMS — Prisma schema
// MongoDB + Prisma schema for local development and serverless deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ----------------------------- Users & Auth -----------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  READER
  SEO_MANAGER
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  IN_EDIT
  APPROVED
  PUBLISHED
  SCHEDULED
  ARCHIVED
  REJECTED
}

model User {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  email         String   @unique
  passwordHash  String?
  image         String?
  role          UserRole @default(READER)
  bio           String?
  socialLinks   String? // JSON string
  isVerified    Boolean  @default(false)
  isBanned      Boolean  @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  articles      Article[]
  comments      Comment[]
  bookmarks     Bookmark[]
  commentLikes  CommentLike[]
  notifications Notification[]
  auditLogs     AuditLog[]
  followers     Follow[]       @relation("FollowerRef")
  following     Follow[]       @relation("FollowingRef")
  sessions      Session[]
  accounts      Account[]
  media         Media[]

  @@index([role])
}

model Account {
  id                    String    @id @default(cuid()) @map("_id")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Follow {
  id          String   @id @default(cuid()) @map("_id")
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowerRef", fields: [followerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  following   User     @relation("FollowingRef", fields: [followingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ----------------------------- Taxonomy -----------------------------

model Category {
  id             String     @id @default(cuid()) @map("_id")
  name           String
  nameEn         String?
  slug           String     @unique
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Category[] @relation("CategoryTree")
  description    String?
  icon           String?
  color          String?
  seoTitle       String?
  seoDescription String?
  order          Int        @default(0)
  isFeatured     Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  articles Article[]

  @@index([parentId])
  @@index([isActive, order])
  @@index([parentId, isActive, order])
}

model Tag {
  id        String   @id @default(cuid()) @map("_id")
  name      String   @unique
  slug      String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articleIds String[]
  articles   Article[] @relation(fields: [articleIds], references: [id])

  @@index([count])
}

// ----------------------------- Articles -----------------------------

model Article {
  id              String        @id @default(cuid()) @map("_id")
  title           String
  titleEn         String?
  slug            String        @unique
  summary         String
  content         String // TipTap JSON serialized
  featuredImage   String?
  featuredImageCaption String?
  gallery         String? // JSON array of image urls
  videoUrl        String?
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryIds     String[]      @default([])
  subcategoryId   String?
  tagIds          String[]
  tags            Tag[]         @relation(fields: [tagIds], references: [id])
  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id])
  source          String?
  location        String?
  country         String?
  division        String?
  district        String?
  isBreaking      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  isTrending      Boolean       @default(false)
  isEditorsPick   Boolean       @default(false)
  isLiveBlog      Boolean       @default(false)
  status          ArticleStatus @default(DRAFT)
  publishDate     DateTime?
  scheduledDate   DateTime?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  keywords        String?
  ogImage         String?
  views           Int           @default(0)
  readingTime     Int           @default(3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  comments    Comment[]
  bookmarks   Bookmark[]
  liveUpdates LiveUpdate[]

  @@index([categoryId])
  @@index([categoryIds])
  @@index([status])
  @@index([publishDate])
  @@index([isBreaking])
  @@index([isFeatured])
  @@index([status, publishDate])
  @@index([status, views])
  @@index([status, categoryId, publishDate])
  @@index([status, isBreaking, publishDate])
  @@index([status, isFeatured, publishDate])
  @@index([status, isTrending, views])
  @@index([status, isEditorsPick, publishDate])
}

model LiveUpdate {
  id        String   @id @default(cuid()) @map("_id")
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([articleId])
}

// ----------------------------- Comments -----------------------------

model Comment {
  id         String        @id @default(cuid()) @map("_id")
  articleId  String
  article    Article       @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  guestName  String?
  content    String
  parentId   String?
  parent     Comment?      @relation("CommentTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    Comment[]     @relation("CommentTree")
  likes      CommentLike[]
  likesCount Int           @default(0)
  isPinned   Boolean       @default(false)
  isApproved Boolean       @default(true)
  isReported Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([articleId])
  @@index([parentId])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Bookmark {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
}

// ----------------------------- Media -----------------------------

model Media {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  url       String
  type      String // image | video | document
  mimeType  String
  size      Int      @default(0)
  folder    String   @default("default")
  altText   String?
  caption   String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([folder])
  @@index([type])
  @@index([userId])
}

// ----------------------------- Engagement -----------------------------

model Poll {
  id        String    @id @default(cuid()) @map("_id")
  question  String
  options   String // JSON array
  votes     String? // JSON {optionIndex: count}
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([isActive])
  @@index([isActive, createdAt])
}

model Newsletter {
  id         String   @id @default(cuid()) @map("_id")
  email      String   @unique
  isVerified Boolean  @default(false)
  token      String?
  createdAt  DateTime @default(now())
}

model Ad {
  id          String   @id @default(cuid()) @map("_id")
  zone        String // header | sidebar | inline | footer | sticky
  title       String
  imageUrl    String?
  linkUrl     String?
  htmlCode    String?
  isActive    Boolean  @default(true)
  impressions Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([zone, isActive])
  @@index([zone, isActive, order])
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type      String // comment | article | approval | mention
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // create | update | delete | publish | approve | reject
  entity    String // article | category | user | comment ...
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// ----------------------------- Site Settings -----------------------------

model Setting {
  id    String @id @default(cuid()) @map("_id")
  key   String @unique
  value String
}

model Menu {
  id       String  @id @default(cuid()) @map("_id")
  name     String
  slug     String  @unique
  location String? // e.g. "HEADER", "FOOTER"
  items    String // JSON tree
  isActive Boolean @default(true)
}

model Video {
  id         String   @id @default(cuid()) @map("_id")
  title      String
  slug       String   @unique
  source     String // youtube | facebook | self
  url        String
  embedHtml  String?
  thumbnail  String?
  duration   String?
  views      Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isFeatured])
  @@index([createdAt])
}

// ----------------------------- Pages (Page Builder) ----------------------

model Page {
  id              String   @id @default(cuid()) @map("_id")
  title           String
  slug            String   @unique
  content         String // HTML content
  excerpt         String?
  featuredImage   String?
  status          String   @default("PUBLISHED") // PUBLISHED | DRAFT
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?
  showInFooter    Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
